# Copy: cp deploy/example.env deploy/.env
# Edit all indicated values before running. NEVER COMMIT deploy/.env.
HYDRIA_OS_DOMAIN=os.example.org
HYDRIA_OS_PUBLIC_ORIGIN=https://os.example.org
HYDRIA_OS_ACCESS_USERNAME=hydria_owner
HYDRIA_OS_ACCESS_PASSWORD=REPLACE_THIS_WITH_A_GENERATED_RANDOM_PASSWORD_LONGER_THAN_20_CHARS
NODE_ENV=production
LOCAL_LLM_ENABLED=false
ENABLE_LOCAL_TOOLS=false
ENABLE_BROWSER_PREVIEW=false
HYDRIA_FLOW_SCHEDULER_ENABLED=false
# HYDRIA_FLOW_CONNECTOR_TOKEN=REPLACE_WITH_A_SEPARATE_RANDOM_SECRET
