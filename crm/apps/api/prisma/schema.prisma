generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum ForecastCategory {
  PIPELINE
  BEST_CASE
  COMMIT
  CLOSED
  OMITTED
}

enum LeadStatus {
  NEW
  WORKING
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum LeadRating {
  HOT
  WARM
  COLD
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_REMINDER
  TASK_OVERDUE
  TASK_COMPLETED
  TICKET_ESCALATED
  TICKET_SLA_BREACH
}

enum AuthTokenType {
  INVITATION
  PASSWORD_RESET
  EMAIL_VERIFICATION
  PORTAL_ACCESS
}

enum AutomationTrigger {
  LEAD_CREATED
  LEAD_STATUS_CHANGED
  DEAL_CREATED
  DEAL_STAGE_CHANGED
  TASK_OVERDUE
  QUOTE_ACCEPTED
}

enum AutomationAction {
  ASSIGN_OWNER
  CREATE_TASK
  SEND_EMAIL
  UPDATE_FIELD
  MOVE_DEAL_STAGE
}

enum IntegrationProvider {
  GOOGLE
  MICROSOFT
  ACCOUNTING
  SUPPORT
  MARKETING
  PAYMENT
  CUSTOM
}

enum ConnectionStatus {
  ACTIVE
  EXPIRED
  ERROR
  DISCONNECTED
}

enum EmailMessageStatus {
  DRAFT
  QUEUED
  SENT
  FAILED
}

enum CalendarEventStatus {
  CONFIRMED
  CANCELED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SignatureStatus {
  PENDING
  SIGNED
  DECLINED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  REFUNDED
  VOID
  OVERDUE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum CreditNoteStatus {
  DRAFT
  ISSUED
  VOID
}

enum EmailDirection {
  OUTBOUND
  INBOUND
}

enum BackgroundJobType {
  EMAIL_SEND
  WEBHOOK_DELIVERY
  INTEGRATION_SYNC
  INVOICE_REMINDER
  AUTOMATION_ACTION
  SEQUENCE_STEP
}

enum BackgroundJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
}

enum ConsentStatus {
  GRANTED
  WITHDRAWN
}

enum PrivacyRequestType {
  EXPORT
  ANONYMIZE
  DELETE
}

enum PrivacyRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
  DEAL_STAGE_CHANGED
  LEAD_CONVERTED
  QUOTE_STATUS_CHANGED
  RECORD_CREATED
  RECORD_UPDATED
}

enum CustomEntityType {
  CONTACT
  COMPANY
  DEAL
  LEAD
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
}

enum WorkspaceEntityType {
  CONTACT
  COMPANY
  DEAL
  LEAD
  EMAIL
  TICKET
}

enum SavedViewResource {
  CONTACTS
  COMPANIES
  LEADS
  DEALS
  TASKS
  PRODUCTS
  QUOTES
  INVOICES
  TICKETS
}

model Organization {
  id                     String                  @id @default(uuid())
  name                   String
  slug                   String                  @unique
  logoUrl                String?
  brandColor             String                  @default("#167d68")
  defaultCurrency        String                  @default("EUR")
  locale                 String                  @default("fr-FR")
  timezone               String                  @default("Europe/Paris")
  defaultTaxPercent      Decimal                 @default(20) @db.Decimal(5, 2)
  paymentTermsDays       Int                     @default(30)
  quotePrefix            String                  @default("Q")
  invoicePrefix          String                  @default("INV")
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  users                  User[]
  companies              Company[]
  contacts               Contact[]
  leads                  Lead[]
  pipelineStages         PipelineStage[]
  deals                  Deal[]
  products               Product[]
  quotes                 Quote[]
  dealLineItems          DealLineItem[]
  quoteLineItems         QuoteLineItem[]
  tasks                  Task[]
  tickets                Ticket[]
  supportQueues          SupportQueue[]
  ticketMessages         TicketMessage[]
  ticketEvents           TicketEvent[]
  notes                  Note[]
  activities             Activity[]
  customFieldDefinitions CustomFieldDefinition[]
  customFieldValues      CustomFieldValue[]
  attachments            Attachment[]
  savedViews             SavedView[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  authSessions           AuthSession[]
  authTokens             AuthToken[]
  automationRules        AutomationRule[]
  automationRuns         AutomationRun[]
  apiKeys                ApiKey[]
  oauthConnections       OAuthConnection[]
  oauthAttempts          OAuthAttempt[]
  emailTemplates         EmailTemplate[]
  emailMessages          EmailMessage[]
  calendarEvents         CalendarEvent[]
  webhookEndpoints       WebhookEndpoint[]
  webhookDeliveries      WebhookDelivery[]
  salesGoals             SalesGoal[]
  quoteVersions          QuoteVersion[]
  quoteApprovals         QuoteApproval[]
  signatureRequests      SignatureRequest[]
  invoices               Invoice[]
  payments               Payment[]
  creditNotes            CreditNote[]
  consents               Consent[]
  privacyRequests        PrivacyRequest[]
  backupSchedules        BackupSchedule[]
  errorEvents            ErrorEvent[]
  backgroundJobs         BackgroundJob[]
  dashboardPreferences   DashboardPreference[]
  campaigns              Campaign[]
  territories            Territory[]
  sequences              Sequence[]
  sequenceEnrollments    SequenceEnrollment[]
  customReports          CustomReport[]
  teams                  Team[]
  customObjectDefinitions CustomObjectDefinition[]
  customObjectRecords    CustomObjectRecord[]
  retentionDays          Int                     @default(2555)
}

model User {
  id                  String               @id @default(uuid())
  organizationId      String
  email               String               @unique
  passwordHash        String
  firstName           String
  lastName            String
  role                UserRole             @default(MEMBER)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownedCompanies      Company[]            @relation("CompanyOwner")
  ownedContacts       Contact[]            @relation("ContactOwner")
  ownedDeals          Deal[]               @relation("DealOwner")
  ownedLeads          Lead[]               @relation("LeadOwner")
  ownedQuotes         Quote[]              @relation("QuoteOwner")
  assignedTasks       Task[]               @relation("TaskAssignee")
  createdTasks        Task[]               @relation("TaskCreator")
  assignedTickets     Ticket[]             @relation("TicketAssignee")
  createdTickets      Ticket[]             @relation("TicketCreator")
  ticketMessages      TicketMessage[]
  ticketEvents        TicketEvent[]
  notes               Note[]
  activities          Activity[]
  attachments         Attachment[]
  savedViews          SavedView[]
  auditLogs           AuditLog[]           @relation("AuditActor")
  notifications       Notification[]
  emailVerifiedAt     DateTime?
  mfaEnabled          Boolean              @default(false)
  mfaSecret           String?
  mfaRecoveryCodes    Json?
  authSessions        AuthSession[]
  authTokens          AuthToken[]
  oauthAttempts       OAuthAttempt[]
  dashboardPreference DashboardPreference?
  territoryId         String?
  territory           Territory?           @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  teamId              String?
  team                Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  permissionPolicy    Json?

  @@index([organizationId])
  @@index([organizationId, territoryId])
  @@index([organizationId, teamId])
}

model Team {
  id               String       @id @default(uuid())
  organizationId   String
  name             String
  permissionPolicy Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users            User[]

  @@unique([organizationId, name])
}

model CustomObjectDefinition {
  id             String               @id @default(uuid())
  organizationId String
  key            String
  name           String
  pluralName     String
  description    String?
  fields         Json
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records        CustomObjectRecord[]

  @@unique([organizationId, key])
}

model CustomObjectRecord {
  id             String                 @id @default(uuid())
  organizationId String
  definitionId   String
  ownerId        String?
  displayName    String
  values         Json
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  definition     CustomObjectDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@index([organizationId, definitionId, updatedAt])
}

model Company {
  id             String       @id @default(uuid())
  organizationId String
  ownerId        String?
  name           String
  domain         String?
  industry       String?
  size           Int?
  phone          String?
  website        String?
  address        String?
  city           String?
  country        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User?        @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts       Contact[]
  deals          Deal[]
  convertedLeads Lead[]       @relation("ConvertedCompany")
  quotes         Quote[]
  tasks          Task[]
  tickets        Ticket[]
  notes          Note[]
  activities     Activity[]

  @@index([organizationId, name])
}

model Contact {
  id                  String               @id @default(uuid())
  organizationId      String
  ownerId             String?
  companyId           String?
  firstName           String
  lastName            String
  email               String?
  phone               String?
  jobTitle            String?
  status              String               @default("lead")
  source              String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner               User?                @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  company             Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  primaryDeals        Deal[]               @relation("PrimaryContact")
  convertedLeads      Lead[]               @relation("ConvertedContact")
  quotes              Quote[]
  tasks               Task[]
  tickets             Ticket[]
  notes               Note[]
  activities          Activity[]
  sequenceEnrollments SequenceEnrollment[]

  @@index([organizationId, lastName, firstName])
  @@index([organizationId, email])
}

model PipelineStage {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  position       Int
  color          String       @default("#167d68")
  isWon          Boolean      @default(false)
  isLost         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals          Deal[]

  @@unique([organizationId, position])
}

model Lead {
  id                  String               @id @default(uuid())
  organizationId      String
  ownerId             String?
  firstName           String
  lastName            String
  companyName         String?
  email               String?
  phone               String?
  jobTitle            String?
  website             String?
  source              String?
  status              LeadStatus           @default(NEW)
  rating              LeadRating           @default(WARM)
  annualRevenue       Decimal?             @db.Decimal(14, 2)
  employeeCount       Int?
  description         String?
  score               Int                  @default(0)
  campaignId          String?
  territoryId         String?
  convertedAt         DateTime?
  convertedCompanyId  String?
  convertedContactId  String?
  convertedDealId     String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner               User?                @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  campaign            Campaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  territory           Territory?           @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  convertedCompany    Company?             @relation("ConvertedCompany", fields: [convertedCompanyId], references: [id], onDelete: SetNull)
  convertedContact    Contact?             @relation("ConvertedContact", fields: [convertedContactId], references: [id], onDelete: SetNull)
  convertedDeal       Deal?                @relation("ConvertedDeal", fields: [convertedDealId], references: [id], onDelete: SetNull)
  tasks               Task[]
  notes               Note[]
  activities          Activity[]
  sequenceEnrollments SequenceEnrollment[]

  @@index([organizationId, status, rating])
  @@index([organizationId, email])
  @@index([organizationId, score])
  @@index([organizationId, campaignId])
  @@index([organizationId, territoryId])
}

model Deal {
  id               String           @id @default(uuid())
  organizationId   String
  ownerId          String?
  companyId        String?
  primaryContactId String?
  stageId          String
  name             String
  value            Decimal          @default(0) @db.Decimal(14, 2)
  currency         String           @default("EUR")
  probability      Int              @default(20)
  status           DealStatus       @default(OPEN)
  forecastCategory ForecastCategory @default(PIPELINE)
  description      String?
  nextStep         String?
  lostReason       String?
  competitor       String?
  campaignId       String?
  territoryId      String?
  expectedCloseAt  DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner            User?            @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  campaign         Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  territory        Territory?       @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  company          Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  primaryContact   Contact?         @relation("PrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  convertedLeads   Lead[]           @relation("ConvertedDeal")
  stage            PipelineStage    @relation(fields: [stageId], references: [id], onDelete: Restrict)
  tasks            Task[]
  notes            Note[]
  activities       Activity[]
  lineItems        DealLineItem[]
  quotes           Quote[]

  @@index([organizationId, stageId])
  @@index([organizationId, status])
  @@index([organizationId, campaignId])
  @@index([organizationId, territoryId])
}

model Product {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  sku            String
  description    String?
  unitPrice      Decimal         @default(0) @db.Decimal(14, 2)
  currency       String          @default("EUR")
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealLineItems  DealLineItem[]
  quoteLineItems QuoteLineItem[]

  @@unique([organizationId, sku])
  @@index([organizationId, active, name])
}

model DealLineItem {
  id              String       @id @default(uuid())
  organizationId  String
  dealId          String
  productId       String
  quantity        Decimal      @default(1) @db.Decimal(12, 2)
  unitPrice       Decimal      @db.Decimal(14, 2)
  discountPercent Decimal      @default(0) @db.Decimal(5, 2)
  lineTotal       Decimal      @db.Decimal(14, 2)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal            Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  product         Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([dealId, productId])
  @@index([organizationId, dealId])
}

model Quote {
  id              String             @id @default(uuid())
  organizationId  String
  ownerId         String?
  dealId          String
  companyId       String?
  contactId       String?
  number          String
  name            String
  status          QuoteStatus        @default(DRAFT)
  validUntil      DateTime?
  subtotal        Decimal            @default(0) @db.Decimal(14, 2)
  discountPercent Decimal            @default(0) @db.Decimal(5, 2)
  taxPercent      Decimal            @default(0) @db.Decimal(5, 2)
  total           Decimal            @default(0) @db.Decimal(14, 2)
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner           User?              @relation("QuoteOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  deal            Deal               @relation(fields: [dealId], references: [id], onDelete: Cascade)
  company         Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact         Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lineItems       QuoteLineItem[]
  versions        QuoteVersion[]
  approvals       QuoteApproval[]
  signatures      SignatureRequest[]
  invoices        Invoice[]

  @@unique([organizationId, number])
  @@index([organizationId, status, createdAt])
}

model QuoteLineItem {
  id              String       @id @default(uuid())
  organizationId  String
  quoteId         String
  productId       String?
  description     String
  quantity        Decimal      @default(1) @db.Decimal(12, 2)
  unitPrice       Decimal      @db.Decimal(14, 2)
  discountPercent Decimal      @default(0) @db.Decimal(5, 2)
  lineTotal       Decimal      @db.Decimal(14, 2)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote           Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product         Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([organizationId, quoteId])
}

model Task {
  id                    String         @id @default(uuid())
  organizationId        String
  createdById           String
  assignedToId          String?
  contactId             String?
  companyId             String?
  dealId                String?
  leadId                String?
  title                 String
  description           String?
  status                TaskStatus     @default(TODO)
  priority              TaskPriority   @default(MEDIUM)
  dueAt                 DateTime?
  reminderAt            DateTime?
  reminderSentAt        DateTime?
  overdueNotifiedAt     DateTime?
  recurrence            TaskRecurrence @default(NONE)
  recurrenceInterval    Int            @default(1)
  recurrenceEndsAt      DateTime?
  recurrenceSeriesId    String?
  recurrenceProcessedAt DateTime?
  completedAt           DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  organization          Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy             User           @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo            User?          @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  contact               Contact?       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company               Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal                  Deal?          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lead                  Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  notifications         Notification[]

  @@index([organizationId, status, dueAt])
  @@index([organizationId, reminderAt, reminderSentAt])
  @@index([organizationId, recurrenceSeriesId])
}

model Ticket {
  id             String         @id @default(uuid())
  organizationId String
  createdById    String
  assignedToId   String?
  contactId      String?
  companyId      String?
  queueId        String?
  number         String
  subject        String
  description    String?
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(MEDIUM)
  source         String         @default("MANUAL")
  dueAt          DateTime?
  firstResponseDueAt DateTime?
  resolutionDueAt    DateTime?
  firstRespondedAt   DateTime?
  slaBreachedAt      DateTime?
  escalatedAt        DateTime?
  escalationLevel    Int            @default(0)
  slaPausedAt        DateTime?
  slaPausedMinutes   Int            @default(0)
  customerEmail      String?
  portalToken        String         @unique @default(uuid())
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User           @relation("TicketCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo     User?          @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  contact        Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company        Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  queue          SupportQueue?  @relation(fields: [queueId], references: [id], onDelete: SetNull)
  messages       TicketMessage[]
  events         TicketEvent[]

  @@unique([organizationId, number])
  @@index([organizationId, status, priority, updatedAt])
  @@index([organizationId, assignedToId, status])
  @@index([organizationId, queueId, status])
  @@index([organizationId, resolutionDueAt, status])
}

model SupportQueue {
  id                       String       @id @default(uuid())
  organizationId           String
  name                     String
  description              String?
  firstResponseMinutes     Int          @default(240)
  resolutionMinutes        Int          @default(1440)
  escalationAfterMinutes   Int          @default(720)
  routingStrategy          String       @default("ROUND_ROBIN")
  businessHours            Json?
  holidays                 Json?
  pauseStatuses            Json?
  escalationPolicy         Json?
  active                   Boolean      @default(true)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tickets                  Ticket[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model TicketMessage {
  id             String       @id @default(uuid())
  organizationId String
  ticketId       String
  authorId       String?
  authorName     String?
  authorEmail    String?
  body           String
  public         Boolean      @default(true)
  inbound        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket         Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author         User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId, ticketId, createdAt])
}

model TicketEvent {
  id             String       @id @default(uuid())
  organizationId String
  ticketId       String
  actorId        String?
  type           String
  summary        String
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket         Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, ticketId, createdAt])
}

model Notification {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  taskId         String?
  type           NotificationType
  eventKey       String           @unique
  title          String
  body           String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  task           Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt, createdAt])
}

model AuthSession {
  id               String       @id @default(uuid())
  organizationId   String
  userId           String
  refreshTokenHash String       @unique
  userAgent        String?
  ipAddress        String?
  lastUsedAt       DateTime     @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime     @default(now())
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

