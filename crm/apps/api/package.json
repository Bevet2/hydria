{
  "name": "@northstar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gate:operations": "tsx scripts/operationsGate.ts",
    "gate:productivity": "tsx scripts/productivityGate.ts",
    "gate:platform": "tsx scripts/platformGate.ts",
    "gate:resilience": "tsx scripts/resilienceGate.ts",
    "gate:oauth": "tsx scripts/oauthGate.ts",
    "gate:communications": "tsx scripts/communicationsGate.ts",
    "gate:load": "tsx scripts/loadGate.ts",
    "gate:commercial": "tsx scripts/commercialGate.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.2",
    "cors": "2.8.5",
    "csv-parse": "6.1.0",
    "csv-stringify": "6.6.0",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.1",
    "multer": "2.1.1",
    "pdfkit": "^0.17.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/multer": "2.0.0",
    "@types/node": "22.15.30",
    "@types/pdfkit": "^0.17.5",
    "prisma": "6.19.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
