# Hydria OS private single-owner deployment template (DO NOT COMMIT REAL SECRETS).
# Copy the variables to a private environment file, e.g. deploy/.env.production.
# Access to Hydria OS is denied at startup if required settings are absent.
NODE_ENV=production
PORT=3001

# Production URL must be an HTTPS origin: scheme + hostname, no path.
HYDRIA_OS_PUBLIC_ORIGIN=https://os.example.org
HYDRIA_OS_ACCESS_USERNAME=hydria_owner
# Use a random unique password of at least 20 characters (not this placeholder).
HYDRIA_OS_ACCESS_PASSWORD=REPLACE_WITH_RANDOM_PRIVATE_SECRET_AT_LEAST_20_CHARS

# Persist state outside the application code; include this in backups.
HYDRIA_OS_DATA_DIR=/app/data

# Privileged local tooling is disabled by default in production.
ENABLE_LOCAL_TOOLS=false
ENABLE_BROWSER_PREVIEW=false

# Optional: automatic data flows (requires an additional private connector token).
HYDRIA_FLOW_SCHEDULER_ENABLED=false
# HYDRIA_FLOW_CONNECTOR_TOKEN=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET

# Models are optional and require a reachable provider.
LOCAL_LLM_ENABLED=false
# HYDRIA_CORE_ENABLED=true
# HYDRIA_CORE_BASE_URL=https://your-hydria-core.example/api/v1
# HYDRIA_CORE_API_KEY=REPLACE_ME

# For Docker + Caddy set HYDRIA_OS_DOMAIN=os.example.org separately.
# Never publish port 3001 directly to the Internet.
